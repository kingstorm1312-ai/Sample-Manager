<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectName>Sample Manager</ProjectName>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SampleManager</RootNamespace>
    <AssemblyName>Sample Manager</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutDir>$(MSBuildProjectDirectory)\..\..\</OutDir>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</IntermediateOutputPath>
    <CscToolPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\</CscToolPath>
    <CscToolExe>csc.exe</CscToolExe>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AppTheme.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="SampleRequestForm.cs" />
    <Compile Include="SampleRequestCreationService.cs" />
    <Compile Include="RequestManagementForm.cs" />
    <Compile Include="RequestDetailForm.cs" />
    <Compile Include="SampleManagementForm.cs" />
    <Compile Include="SampleDetailForm.cs" />
    <Compile Include="SampleManagerCache.cs" />
    <Compile Include="SampleNormalization.cs" />
    <Compile Include="UpdateService.cs" />
    <Compile Include="AuthenticationService.cs" />
    <Compile Include="PasswordDialog.cs" />
    <Compile Include="GoogleOAuth.cs" />
    <Compile Include="GatewaySettings.cs" />
    <Compile Include="ClientIdentity.cs" />
    <Compile Include="SampleWriteGatewayClient.cs" />
    <Compile Include="GoogleSheetsSampleRepository.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="Build">
    <MakeDir Directories="$(OutDir);$(IntermediateOutputPath)" />
    <Csc
      Sources="@(Compile)"
      References="C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Core.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Drawing.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Windows.Forms.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Web.Extensions.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Xml.dll;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Security.dll"
      TargetType="winexe"
      OutputAssembly="$(OutDir)$(AssemblyName).exe"
      Optimize="true"
      DebugType="none"
      DefineConstants="$(DefineConstants)" />
  </Target>
</Project>
